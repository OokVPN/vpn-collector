{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/subscription.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "profile-title",
          "value": "sub"
        },
        {
          "key": "announce",
          "value": "test sub"
        },
        {
          "key": "profile-update-interval",
          "value": "1"
        },
        {
          "key": "subscription-userinfo",
          "value": "upload=0; download=0; total=0"
        }
      ]
    }
  ]
}
